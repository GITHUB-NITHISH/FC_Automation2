<?xml version="1.0" encoding="UTF-8"?>
<suite name="Cross Browser Suite" parallel="tests" thread-count="2" verbose="2">
    
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.automation.runner.CucumberParallelTestRunner"/>
        </classes>
    </test>
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.automation.runner.CucumberParallelTestRunner"/>
        </classes>
    </test>
    
</suite>
