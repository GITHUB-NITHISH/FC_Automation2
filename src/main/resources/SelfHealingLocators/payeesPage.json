			"primary": "xpath=//h3[normalize-space()='Billing Address']//parent::div//following-sibling::div//span[normalize-space()='Validate Address']//ancestor::button",
			"secondary": "xpath=//button[contains(.,'Validate Address')]",
			"tertiary": "css=button"
		},
