			"tertiary": "xpath=//label[@for='preferredCadPaymentMethod']/following-sibling::*//button[@ngbdropdowntoggle]"
		},
		"preferredUsdPaymentMethodDropdown": {
			"primary": "xpath=//label[@for='preferredUsdPaymentMethod']//parent::div//button//span",
