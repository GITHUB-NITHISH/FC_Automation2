{
	"payeesPage": {
		"payeeHeader": {
			"primary": "xpath=//h1[.//fa-icon[contains(@class,'ng-fa-icon')]]",
			"secondary": "css=h1:has(fa-icon.ng-fa-icon)",
			"tertiary": "xpath=//fa-icon[contains(@class,'mr-1')]/parent::h1"
		},
		"payeeTile": {
			"primary": "xpath=//a[@href='ap/admin/payees']",
			"secondary": "css=a[href='ap/admin/payees']",
			"tertiary": "xpath=//a[contains(@href,'payees')]"
		},
		"addNewPayeeButton": {
			"primary": "xpath=//button[normalize-space()='Add New Payee']",
			"secondary": "css=button",
			"tertiary": "xpath=//button[contains(text(),'Add New Payee')]"
		},
		"payeeNameField": {
			"primary": "xpath=//label[@for='payeeName']//parent::div//input",
			"secondary": "css=input[formcontrolname='payeeName']",
			"tertiary": "xpath=//input[contains(@id,'payeeName')]"
		},
		"linkToPayeeDropdown": {
			"primary": "xpath=//label[@id='linkToPayee']//parent::div//button",
