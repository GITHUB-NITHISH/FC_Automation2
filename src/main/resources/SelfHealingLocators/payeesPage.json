		},
		"linkToPayeeOption": {
			"primary": "xpath=//div[@class='dropdown-checkboxes limit-height']//label[text()='${value}']",
			"secondary": "xpath=//label[normalize-space()='${value}']",
			"tertiary": "css=div.dropdown-checkboxes label"
		},
		"mailingAddressField": {
			"primary": "xpath=//label[@for='mailingAddress']//parent::div//input",
