		},
		"usdPaymentMethodDropdownSearch": {
			"primary": "xpath=//div[@class='single-select-dropdown-menu dropdown-menu show']//parent::div//input",
			"secondary": "xpath=//label[contains(text(),'Preferred USD Payment Method')]/parent::div//input[@placeholder='Search ...']",
			"tertiary": "xpath=//label[@for='preferredUsdPaymentMethod']/ancestor::div[contains(@class,'form-group')]//input[@placeholder='Search ...']"
		},
		"usdPaymentMethodSearchResult": {
			"primary": "xpath=//label[@for='preferredUsdPaymentMethod']/parent::div//button[contains(@class,'dropdown-item') and contains(text(),'${value}')]",
			"secondary": "xpath=//label[@for='preferredUsdPaymentMethod']/ancestor::div[contains(@class,'form-group')]//button[contains(@class,'dropdown-item') and contains(normalize-space(),'${value}')]",
			"tertiary": "xpath=//button[contains(@class,'searchable-select-option') and contains(normalize-space(), '${value}')]"
		},
		"selectAccountDropdown": {
			"primary": "xpath=//label[@id='linkAccounts']/following::div//button[@class='dropdown-toggle custom-select']",
			"secondary": "xpath=//label[@id='linkAccounts']/following::div//button[contains(@class,'dropdown-toggle')]",
			"tertiary": "xpath=//label[@id='linkAccounts']/following::button[contains(@class,'custom-select') and @type='button']"
		},
		"selectAccountDropdownSearch": {
			"primary": "xpath=//label[@id='linkAccounts']/following::div//input[@class='form-control ng-valid ng-dirty ng-touched']",
			"secondary": "xpath=//label[@id='linkAccounts']/following::input[contains(@class,'form-control')]",
			"tertiary": "xpath=//label[@id='linkAccounts']/following::div//input[contains(@class,'ng-valid') and (@id='searchText-XhVexKno')]"
		},
		"selectAccountSearchResult": {
			"primary": "xpath=//div[contains(@class,'show dropdown')]//button[@aria-expanded='true']//following::div//label[normalize-space()='${value}']",
			"secondary": "xpath=//div[contains(@class,'show dropdown')]//label[contains(normalize-space(), '${value}')]",
			"tertiary": "xpath=//button[@aria-expanded='true']//following::label[contains(normalize-space(), '${value}')]"
		},
		"savePayeeButton": {
			"primary": "xpath=//button[contains(@type,'submit') and normalize-space()='Save Payee']",
			"secondary": "css=button[type='submit']",
			"tertiary": "xpath=//button[contains(text(),'Save Payee')]"
		},
		"payeeCreatedPopupModal": {
			"primary": "xpath=//h2[normalize-space()='Payee Created']//following::div[@class='modal-section-highlighted']",
			"secondary": "xpath=//div[contains(@class,'modal-section-highlighted')]",
			"tertiary": "css=.modal-section-highlighted"
		},
		"closeButton": {
			"primary": "xpath=//button[text()='Close']",
			"secondary": "css=button",
			"tertiary": "xpath=//button[contains(text(),'Close')]"
		},
		"payeeDetailsDropdown": {
			"primary": "xpath=//label[normalize-space()='Payees Details']//parent::div//button",
			"secondary": "css=button.dropdown-toggle",
			"tertiary": "xpath=//button[contains(@aria-expanded,'false')]"
		},
		"payeeDetailsSearchField": {
			"primary": "xpath=//label[normalize-space()='Search:']//parent::div//input",
			"secondary": "css=input[type='search']",
			"tertiary": "xpath=//input[contains(@placeholder,'Search')]"
		},
		"payeeDetailsOption": {
			"primary": "xpath=//div[contains(@class,'show dropdown')]//button[@aria-expanded='true']//following::div//label[normalize-space()='${value}']",
			"secondary": "xpath=//label[normalize-space()='${value}']",
			"tertiary": "css=label"
		},
		"searchButton": {
			"primary": "xpath=//button[normalize-space()='Search']",
			"secondary": "css=button[type='submit']",
			"tertiary": "xpath=//button[contains(text(),'Search')]"
		},
		"payeeAccountResult": {
			"primary": "xpath=//div[contains(@class,'d-flex flex-column')]//strong[contains(normalize-space(), '${value}')]",
			"secondary": "xpath=//strong[contains(normalize-space(), '${value}')]",
			"tertiary": "xpath=//div[contains(@class,'d-flex')]//strong[contains(text(),'${value}')]"
		},
		"clearFilters": {
			"primary": "xpath=//button[normalize-space()='Clear Filters']",
			"secondary": "css=button",
			"tertiary": "xpath=//button[contains(text(),'Clear')]"
		},
		"homeButton": {
			"primary": "xpath=//div[contains(@class,'logo-image-container')]/following-sibling::span",
			"secondary": "xpath=//div[contains(@class,'logo-image-container')]//following::span",
			"tertiary": "xpath=//span[contains(@class,'logo')]"
		}
	}
